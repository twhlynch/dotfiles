{
	"$schema": "https://opencode.ai/v2/cli.json",
	"theme": {
		"name": "vague"
	},
	"diffs": {
		"wrap": "word"
	},
	"terminal": {
		"title": true,
		"copy": "select"
	},
	"session": {
		"sidebar": "auto",
		"scrollbar": false,
		"thinking": "show",
		"verbosity": "high",
		"image_preview": true,
		"tps": true,
		"permissions": "prompt"
	},
	"animations": true,
	"tabs": {
		"enabled": false,
		"mode": "off"
	}
}
